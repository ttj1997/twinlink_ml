    "stateless": {
      "const": true,
      "default": true,
      "title": "Stateless",
      "type": "boolean"
    },
    "valid_input_ranges": {
      "additionalProperties": {
        "$ref": "#/$defs/ValueRange"
      },
      "title": "Valid Input Ranges",
      "type": "object"
    }
