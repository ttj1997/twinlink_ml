      "$ref": "#/$defs/HeatKeyFigures"
    },
    "lp_failures": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lp Failures"
    },
    "meta": {
      "$ref": "#/$defs/ResponseMeta"
    },
    "mode": {
      "enum": [
        "cascade_rule",
        "planning"
      ],
      "title": "Mode",
      "type": "string"
    },
    "sample_time_s": {
      "title": "Sample Time S",
      "type": "number"
    },
    "sink_heat": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/SinkHeat"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sink Heat"
    },
    "storage_charge_kw": {
      "items": {
        "type": "number"
      },
      "title": "Storage Charge Kw",
      "type": "array"
    },
    "storage_content_kwh": {
