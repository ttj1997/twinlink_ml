# Copy to conf/plant/plant_local.yaml (git-ignored) and replace the placeholder tags by the
# channel names of the plant export. Code and documentation only ever use the ROLES (keys).
# Several tags under one role are averaged (redundant sensors of the same quantity).
# Paths of the raw exports are NOT configured here: they come from the environment variables
# named in the study script, set at the call site.
roles:
  storage_temperature: [TAG_STORAGE_T]                    # only one sensor exported
  storage_loop_flow: [TAG_STORAGE_LOOP_FLOW]              # m3/h, loop through the storage and exchanger A1
  preheater_loop_flow: [TAG_PREHEATER_LOOP_FLOW]          # m3/h, loop exchanger A1 -> preheater A1
  preheater_supply_temperature: [TAG_PREHEATER_SUPPLY_T]  # water side, towards preheater A1
  preheater_return_temperature: [TAG_PREHEATER_RETURN_T]  # water side, from preheater A1
  supply_air_temperature: [TAG_SUPPLY_AIR_T_1, TAG_SUPPLY_AIR_T_2, TAG_SUPPLY_AIR_T_3]
  ambient_temperature: [TAG_AMBIENT_T]                    # intake air
  process_air_flow: [TAG_PROCESS_AIR_FLOW]                # Nm3/h
  steam_valve_position: [TAG_STEAM_VALVE]                 # %, proxy only (split-range, two valves)
  process_fan_power: [TAG_PROCESS_FAN_POWER]              # kW electric
# Exported but NOT used by the storage model (open question, see docs/18):
unused_roles:
  auxiliary_air_heater_outlet_temperature: [TAG_AUX_HEATER_OUTLET_T]

# Roles of the time-slice study (storage test 1, twinlink_ml.storage_timeslice.plant). Several tags
# under one role are averaged, except atomising_air_flow (nozzles are summed).
timeslice_roles:
  ambient_temperature: [TAG_AMBIENT_T]                    # intake air, degC
  process_air_flow: [TAG_PROCESS_AIR_FLOW]                # Nm3/h
  supply_air_temperature: [TAG_SUPPLY_AIR_T_1, TAG_SUPPLY_AIR_T_2, TAG_SUPPLY_AIR_T_3]  # degC
  exhaust_outlet_temperature: [TAG_EXHAUST_OUTLET_T]      # degC, before the filter
  spray_rate: [TAG_SPRAY_RATE]                            # kg/h
  atomising_air_flow: [TAG_NOZZLE_AIR_1, TAG_NOZZLE_AIR_2, TAG_NOZZLE_AIR_3, TAG_NOZZLE_AIR_4, TAG_NOZZLE_AIR_5, TAG_NOZZLE_AIR_6]  # Nm3/h each

# Roles of the operating-point study of plant A (twinlink_ml.plant_a_op.data). Several tags under
# one role are averaged, except atomising_air_flow (nozzles are summed).
operating_point_roles:
  ambient_temperature: [TAG_AMBIENT_T]                    # intake air, degC
  process_air_flow: [TAG_PROCESS_AIR_FLOW]                # Nm3/h
  supply_air_temperature: [TAG_SUPPLY_AIR_T_1, TAG_SUPPLY_AIR_T_2, TAG_SUPPLY_AIR_T_3]  # degC
  exhaust_outlet_temperature: [TAG_EXHAUST_OUTLET_T]      # degC, before the filter
  spray_rate: [TAG_SPRAY_RATE]                            # kg/h
  atomising_air_flow: [TAG_NOZZLE_AIR_1, TAG_NOZZLE_AIR_2, TAG_NOZZLE_AIR_3, TAG_NOZZLE_AIR_4, TAG_NOZZLE_AIR_5, TAG_NOZZLE_AIR_6]  # Nm3/h each
  process_fan_power: [TAG_PROCESS_FAN_POWER]              # kW electric, process-air fan
  exhaust_fan_power: [TAG_EXHAUST_FAN_POWER]              # kW electric, exhaust fan behind the filter
  preheater_loop_flow: [TAG_PREHEATER_LOOP_FLOW]          # m3/h
  preheater_supply_temperature: [TAG_PREHEATER_SUPPLY_T]  # water side, towards the preheater
  preheater_return_temperature: [TAG_PREHEATER_RETURN_T]  # water side, from the preheater
